  "nodes": [
    {
      "id": "e138",
      "level": 1,
      "text": "四、公司情况",
      "sources": [
        "e138"
      ]
    },
    {
      "id": "e139",
      "level": 2,
      "text": "（一）基本信息",
      "sources": [
        "e139"
      ]
    },
    {
      "id": "e140",
      "level": 3,
      "text": "1.设立背景",
      "sources": [
        "e140"
      ],
      "guidance": "实控人及实际持股、背景首句→设立缘由→工商信息表（注明截至时点）→设立后主要研发及应用节点表。"
    },
    {
      "id": "e144",
      "level": 3,
      "text": "2.核心团队",
      "sources": [
        "e144"
      ],
      "guidance": "节首一段：覆盖岗位，全职与兼职名单。"
    },
    {
      "repeat": "team",
      "min_items": 1,
      "sources": [
        "e146",
        "e148",
        "e150",
        "e152",
        "e154",
        "e156",
        "e158",
        "e160"
      ],
      "guidance": "按实控人、首席科学家、经营管理、研发、产品、市场、融资顺序逐人展开；每人一段：出生年月、学历、全职或兼职及持股、履历、在公司的分工。",
      "items": [
        {
          "level": 4,
          "text": "（{n}）{name}，{role}"
        }
      ]
    },
    {
      "id": "e162",
      "level": 3,
      "text": "3.人员及组织架构",
      "sources": [
        "e162"
      ],
      "guidance": "总人数与全兼职→部门、学历、年龄三表→组织分工与核心工程化人员集中度。"
    },
    {
      "id": "e169",
      "level": 3,
      "text": "4.关联公司及经营主体",
      "sources": [
        "e169"
      ],
      "guidance": "子公司、生产场地及拟建基地一表（主体或场地/性质及状态/承担功能），末句写各地分工。"
    },
    {
      "id": "e172",
      "level": 3,
      "text": "5.知识产权",
      "sources": [
        "e172"
      ],
      "guidance": "计数句（发明、实用新型、授权、审查、受理）+明细表（含受让情况）。"
    },
    {
      "id": "e174",
      "level": 3,
      "text": "6.资质及荣誉",
      "sources": [
        "e174"
      ],
      "guidance": "资质表（事项/取得时间/适用对象）→许可或适航路径段（写清资质覆盖范围）→认定、任职及获奖表。"
    },
    {
      "id": "e178",
      "level": 3,
      "text": "7.主要客户及供应商",
      "sources": [
        "e178"
      ]
    },
    {
      "id": "e179",
      "level": 4,
      "text": "（1）主要客户",
      "sources": [
        "e179"
      ],
      "guidance": "分期前五大客户表（名称/金额/占比/交易内容）；表后首句写集中度结论及对核心业务的影响。"
    },
    {
      "id": "e183",
      "level": 4,
      "text": "（2）主要供应商",
      "sources": [
        "e183"
      ],
      "guidance": "分期前五大供应商表；双向购销、高校往来、关键外购件依赖分段交代。"
    },
    {
      "id": "e189",
      "level": 2,
      "text": "（二）股权变动情况",
      "sources": [
        "e189"
      ]
    },
    {
      "id": "e190",
      "level": 3,
      "text": "1.股东结构及控制权",
      "sources": [
        "e190"
      ],
      "guidance": "股东表（认缴/实缴/比例/身份）+控制权段：实控人比例、创始团队合计、机构合计。"
    },
    {
      "id": "e193",
      "level": 3,
      "text": "2.历史融资情况",
      "sources": [
        "e193"
      ],
      "guidance": "签约与到账口径→融资表（时间/轮次/投资方/金额/估值/对赌情况，写明回购义务主体）。"
    },
    {
      "id": "e195",
      "level": 3,
      "text": "3.本轮融资及资金使用计划",
      "sources": [
        "e195"
      ],
      "guidance": "拟融资额、投前投后估值、资金用途，一段写完。"
    },
    {
      "id": "e197",
      "level": 2,
      "text": "（三）财务数据",
      "sources": [
        "e197"
      ]
    },
    {
      "id": "e198",
      "level": 3,
      "text": "1.核心财务数据",
      "sources": [
        "e198"
      ],
      "guidance": "口径句+三段式财务表+一段分析：收入、亏损、费用、毛利率口径、现金流，问题在此段内写清。"
    },
    {
      "id": "e201",
      "level": 3,
      "text": "2.公司收入预测及订单依据",
      "sources": [
        "e201"
      ],
      "guidance": "分产品线分年度预测表，随后以已签与意向订单说明依据。"
    },
    {
      "id": "e203",
      "level": 4,
      "text": "（1）已签在手订单",
      "sources": [
        "e203"
      ],
      "guidance": "项数、金额、交付与确认收入状态+订单明细表。"
    },
    {
      "id": "e205",
      "level": 4,
      "text": "（2）意向订单",
      "sources": [
        "e205"
      ],
      "guidance": "截至日期、项数、金额、计数口径→按交付年份分组→按业务板块分表（项数、金额、占比），点明单一大项占比。"
    }
  ]
}
