  "nodes": [
    {
      "id": "e040",
      "level": 1,
      "text": "二、所属行业分析",
      "sources": [
        "e040"
      ]
    },
    {
      "id": "e041",
      "level": 2,
      "text": "（一）行业发展现状",
      "sources": [
        "e041"
      ],
      "guidance": "节首一段：行业定位与所处阶段，并点明下文按需求、技术路线、商业化与经济性、政策四方面展开。"
    },
    {
      "id": "e043",
      "level": 3,
      "text": "1.{demand_heading}",
      "sources": [
        "e043"
      ],
      "guidance": "需求与空间：界定任务边界（量化门槛）→现有方案为何不能覆盖（量化）→权威数据证明增量需求→细分场景空间表。"
    },
    {
      "id": "e048",
      "level": 3,
      "text": "2.{route_heading}",
      "sources": [
        "e048"
      ],
      "guidance": "技术路线：多路线并行及各自制约→统一前提的控制变量对比表→适用边界与场景分工。"
    },
    {
      "id": "e057",
      "level": 3,
      "text": "3.{commercial_heading}",
      "sources": [
        "e057"
      ],
      "guidance": "商业化：节首一段概括投资关注价值，再分验证转化与经济性两段展开。"
    },
    {
      "id": "e059",
      "level": 4,
      "text": "（1）{validation_heading}",
      "sources": [
        "e059"
      ],
      "guidance": "工程验证→国内外同类进展→付费合同或交付（与公司情况章数字一致）→仍未形成的环节。"
    },
    {
      "id": "e061",
      "level": 4,
      "text": "（2）{economics_heading}",
      "sources": [
        "e061"
      ],
      "guidance": "同等作业量下的成本对比、客户损失节约，配经济性对比表；写明价格假设的公开依据。"
    },
    {
      "id": "e064",
      "level": 3,
      "text": "4.{policy_heading}",
      "sources": [
        "e064"
      ],
      "guidance": "政策：战略定位节点→直接针对细分环节的专项政策与标准（写层级）→配套制度与要素供给→一句总体判断。"
    },
    {
      "id": "e069",
      "level": 2,
      "text": "（二）产业链分析",
      "sources": [
        "e069"
      ],
      "guidance": "节首一段：产业链构成、公司所处环节及其与合作方的分工边界。"
    },
    {
      "id": "e072",
      "level": 3,
      "text": "1.{upstream_heading}",
      "sources": [
        "e072"
      ],
      "guidance": "以“上游”开头写明构成；写各要素对成本、性能、可靠性的作用及国内基础。"
    },
    {
      "id": "e076",
      "level": 3,
      "text": "2.{midstream_heading}",
      "sources": [
        "e076"
      ],
      "guidance": "以“中游”开头；分工表（环节/职责/代表主体/配套能力关键），公司与国内外同类企业并列，写专业门槛与公司进展。"
    },
    {
      "id": "e081",
      "level": 3,
      "text": "3.{downstream_heading}",
      "sources": [
        "e081"
      ],
      "guidance": "以“下游”开头；需求主体与采购逻辑，配应用方向表（方向/需求主体/长续航等核心价值）。"
    }
  ]
}
